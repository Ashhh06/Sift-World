{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "thesift:willow_stairs",
      "menu_category": {
        "category": "construction"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ]
        },
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:vertical_half"
          ]
        }
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.stairs"
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "willow_planks",
          "render_method": "opaque"
        }
      },
      "minecraft:collision_box": [
        {
          "origin": [
            -8,
            0,
            -8
          ],
          "size": [
            16,
            8,
            16
          ]
        },
        {
          "origin": [
            -8,
            8,
            0
          ],
          "size": [
            16,
            8,
            8
          ]
        }
      ],
      "minecraft:selection_box": true,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:flammable": true,
      "minecraft:map_color": "#9BE3D4",
      "minecraft:support": {
        "shape": "stair"
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'bottom' && query.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'bottom' && query.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'bottom' && query.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'bottom' && query.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              270,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'top' && query.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              180,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'top' && query.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              180,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'top' && query.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              180,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:vertical_half') == 'top' && query.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              180,
              270,
              0
            ]
          }
        }
      }
    ]
